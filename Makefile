# snes.dev: build the ROM with ca65/ld65 (cc65 suite) and Python 3.
#
#   make          build build/hello.sfc (plus .dbg symbols for Mesen)
#   make run      open the ROM in Mesen
#   make test     boot the ROM headless in Mesen and check every scene
#   make clean    delete build/
#
# Tool paths can be overridden, e.g. `make run MESEN=~/opt/Mesen/Mesen`.

NAME   := hello
BUILD  := build
ROM    := $(BUILD)/$(NAME).sfc

AS     := ca65
LD     := ld65
PYTHON := python3

ifeq ($(shell uname -s),Darwin)
MESEN  ?= /Applications/Mesen.app/Contents/MacOS/Mesen
else
MESEN  ?= Mesen
endif

# First VRAM tile of the logo. The asset converter and the assembler (-D)
# both need it, so it's defined once, here.
LOGO_TILE := 128

ASFLAGS := --cpu 65816 -g -I src --bin-include-dir $(BUILD) -D LOGO_TILE=$(LOGO_TILE)
LDFLAGS := -C config/lorom32k.cfg --dbgfile $(BUILD)/$(NAME).dbg -m $(BUILD)/$(NAME).map

SRCS := $(wildcard src/*.s)
OBJS := $(SRCS:src/%.s=$(BUILD)/%.o)
GFX  := $(BUILD)/font.chr $(BUILD)/logo.chr $(BUILD)/logo.tilemap

.PHONY: all run test clean

# Generated by pattern rules; keep them (make would delete them as intermediates).
.SECONDARY: $(GFX)

all: $(ROM)

$(ROM): $(OBJS) config/lorom32k.cfg tools/fix_checksum.py
	$(LD) $(LDFLAGS) -o $@ $(OBJS)
	$(PYTHON) tools/fix_checksum.py $@

# --create-dep records each module's .include/.incbin files in a .d file.
$(BUILD)/%.o: src/%.s $(GFX) Makefile | $(BUILD)
	$(AS) $(ASFLAGS) --create-dep $(@:.o=.d) -o $@ $<

$(BUILD)/font.chr: assets/font.txt tools/txt2chr.py | $(BUILD)
	$(PYTHON) tools/txt2chr.py font $< --chr $@

# Images produce tiles + a tilemap. A pattern rule with two targets runs its
# recipe once for both (works in GNU Make 3.81, which macOS ships).
$(BUILD)/%.chr $(BUILD)/%.tilemap: assets/%.txt tools/txt2chr.py Makefile | $(BUILD)
	$(PYTHON) tools/txt2chr.py image $< --chr $(BUILD)/$*.chr \
		--tilemap $(BUILD)/$*.tilemap --base-tile $(LOGO_TILE)

$(BUILD):
	mkdir -p $@

run: $(ROM)
	"$(MESEN)" $(ROM)

# Headless smoke test. The switches are applied for this run only
# (--doNotSaveSettings): plug a controller into port 1 for the script to
# press buttons on, and allow Lua file access so it can save screenshots.
# --timeout (seconds) is a backstop if the script hangs.
test: $(ROM)
	mkdir -p $(BUILD)/screenshots
	SCREENSHOT_DIR="$(abspath $(BUILD)/screenshots)" "$(MESEN)" --testRunner \
		--doNotSaveSettings --enableStdout --timeout=60 \
		--snes.port1.type=SnesController \
		--debug.scriptWindow.allowIoOsAccess=true \
		$(abspath tests/smoke.lua) $(abspath $(ROM))

# Run any target inside the Ubuntu container, e.g. `make docker-test`.
docker-%:
	./tools/docker-make.sh $*

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d)
